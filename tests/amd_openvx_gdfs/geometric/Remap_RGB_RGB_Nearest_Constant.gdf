# agoKernel_Remap_RGB_RGB_Nearest_Constant
data input_1 = uniform-image:1280,720,RGB2,0xAABBCC
data output_1 = image:1280,720,RGB2
data remap_table = remap:1280,720,1280,720:READ,inputs/remap_1280x720_mirror.txt
node org.khronos.openvx.remap input_1 remap_table !NEAREST_NEIGHBOR output_1 attr:BORDER_MODE:CONSTANT,0
