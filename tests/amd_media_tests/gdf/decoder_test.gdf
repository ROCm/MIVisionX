import vx_amd_media

# read input sequences
# $1 arg: data vid1 = scalar:STRING,"1,${ROCM_PATH}/share/mivisionx/test/videos/AMD_driving_virtual_20.mp4:0"
data nvimg  = image:1920,1080,NV12
data loop = scalar:INT32,0
data gpu_out = scalar:INT32,0
node com.amd.amd_media.decode $1 nvimg NULL loop gpu_out
