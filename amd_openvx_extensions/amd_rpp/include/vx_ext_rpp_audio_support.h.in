#ifndef GUARD_VX_EXT_RPP_AUDIO_SUPPORT_H_IN
#define GUARD_VX_EXT_RPP_AUDIO_SUPPORT_H_IN

/*!
 * \file
 * \brief Whether this vx_rpp build has audio kernels
 * \defgroup group_vx_rpp_audio_support
 * \brief vx_rpp audio support
 *
 * vx_rpp builds its audio kernels only when the RPP it was built against has audio
 * augmentations. The audio entry points in vx_ext_rpp.h are declared and exported either way,
 * and a build without them registers its audio kernels with no audio tensor layouts, so an
 * application can only discover the difference when a graph fails to verify. This header is
 * written at configure time so that a consumer can tell the two apart before it builds a graph.
 */

#cmakedefine01 VX_EXT_RPP_AUDIO_SUPPORT

#endif
