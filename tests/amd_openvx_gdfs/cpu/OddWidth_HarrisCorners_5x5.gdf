# Exercise Harris corners 5x5 score path with odd width
data input = uniform-image:641,481,U008,100
data corners = array:VX_TYPE_KEYPOINT,1000
data num_corners = scalar:SIZE,0
data strength_thresh = scalar:FLOAT32,0.001
data min_distance = scalar:FLOAT32,5.0
data sensitivity = scalar:FLOAT32,0.04
data gradient_size = scalar:INT32,5
data block_size = scalar:INT32,5
node org.khronos.openvx.harris_corners input strength_thresh min_distance sensitivity gradient_size block_size corners num_corners
